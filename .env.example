# ローカル開発用。実際の値は Firebase Console > プロジェクトの設定 > 全般 > マイアプリ から取得。
# .env.local にコピーして値を埋める(.env.local はgit管理外)。
# これらはブラウザに公開される値(公開設定値。秘密情報ではない)。

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- サーバー側(Vercel Functions)専用。ローカルでは vercel dev 使用時のみ必要 ---
# Vercelダッシュボードの環境変数として設定し、.envファイルには書かないこと。
# ANTHROPIC_API_KEY=
# GITHUB_TOKEN=
# GITHUB_DATA_REPO=owner/money-lens-data
# ALLOWED_EMAILS=you@example.com
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
