# ローカル開発用。Firebase は household-chore-manager と同じ「共有プロジェクト」を使う。
# 値は共有プロジェクトの Firebase Console > プロジェクトの設定 > 全般 > マイアプリ にある
# Web アプリ設定から取得(このアプリ用に Web アプリを追加登録する必要はない)。
# .env.local にコピーして値を埋める(.env.local はgit管理外)。
# これらはブラウザに公開される値(公開設定値。秘密情報ではない)。
# 切り替え手順: household-chore-manager の docs/firebase-consolidation.md を参照。

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- サーバー側(Vercel Functions)専用。ローカルでは vercel dev 使用時のみ必要 ---
# Vercelダッシュボードの環境変数として設定し、.envファイルには書かないこと。
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# GITHUB_TOKEN=
# GITHUB_DATA_REPO=owner/money-lens-data
# ALLOWED_EMAILS=you@example.com
# 共有プロジェクトの ID(VITE_FIREBASE_PROJECT_ID と同じ値)。推奨。
# このアプリのサーバーは IDトークンの検証しかしないため、サービスアカウントは渡さない
# (渡すと他アプリの Firestore データへの権限を持ってしまう)。
# FIREBASE_PROJECT_ID=
# 旧方式(後方互換。共有プロジェクトでは設定しないこと。FIREBASE_PROJECT_ID があればそちらが優先され、これは無視される):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
